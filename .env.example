# ---- PashuSafe configuration ----
# Copy to backend/.env (or export) and adjust.

# SQLite (default, zero-setup demo) or PostgreSQL:
DATABASE_URL=sqlite:///./pashusafe.db
# DATABASE_URL=postgresql+psycopg://pashu:pashu@localhost:5433/pashusafe

JWT_SECRET=change-me-in-production
ENVIRONMENT=development
# JSON array of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Optional: enables Claude-powered assistant mode (offline fallback used otherwise)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
